// Chacachón — Neon Postgres schema
// docs/database.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

enum StoryVariant {
  NARRATIVE
  APARTMENT
  PILOT
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  name      String?
  image     String?
  role      UserRole       @default(USER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  profile   FamilyProfile?

  @@map("users")
}

model FamilyProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemaVersion Int      @default(1) @map("schema_version")
  perfil        Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("family_profiles")
}

model Story {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  description String?
  moraleja    String?
  familyTag   String?      @map("family_tag")
  accentCode  String       @default("bogota_ninos") @map("accent_code")
  htmlPath    String?      @map("html_path")
  variant     StoryVariant @default(NARRATIVE)
  status      StoryStatus  @default(DRAFT)
  sortOrder   Int          @default(0) @map("sort_order")
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("stories")
}

/// Cuentos generados por el flujo /crear (IA o plantilla mock).
model GeneratedStory {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  title        String
  bodyMarkdown String   @map("body_markdown")
  recipe       Json
  source       String   @default("mock")
  model        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("generated_stories")
}
