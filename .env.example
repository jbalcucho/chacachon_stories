# ============================================================
# Chacachón — environment variables
# Copy to .env.local for local development
# docs/database.md · docs/architecture.md
# ============================================================

# --- Neon Postgres (required for catalog + family profiles) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/chacachon?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/chacachon?sslmode=require"

# --- NextAuth / Google OAuth (required for family profile editing) ---
NEXTAUTH_URL="http://localhost:3000"
# Production: https://chacachon-stories.vercel.app
NEXTAUTH_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Admin (optional) ---
# Comma-separated emails with admin access (publish stories, /admin in future)
ADMIN_EMAILS="tu-email@gmail.com"

# --- IA: generación de cuentos (opcional para el demo) ---
# Prioridad de proveedor: Gemini → Claude → plantilla local (sin ninguna key).
# docs/ia-generacion.md

# Opción A · Gemini (tiene capa GRATIS, ideal para demo) — aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

# Opción B · Claude (pago por uso desde el inicio) — console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# --- Cuotas de generación IA ---
# Máximo de cuentos generados por usuario en ventana de 24 h (requiere sesión).
GENERATION_DAILY_LIMIT="3"
# Alerta en logs si el costo estimado de una generación supera este umbral (USD).
GENERATION_COST_ALERT_USD="0.05"

# Trial anónimo (/probar): cuota cookie+IP/día (default 2).
# TRIAL_AI_DAILY_PER_IP="2"
# TEMP afinado: cuota apagada por defecto en código. Forzar límites: TRIAL_AI_LIMITS_DISABLED=0
# TRIAL_AI_LIMITS_DISABLED="0"
