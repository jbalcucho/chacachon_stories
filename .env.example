# ============================================================
# Chacachón — environment variables
# Copy to .env.local for local development
# docs/database.md · docs/architecture.md
# ============================================================

# --- Neon Postgres (required for catalog + family profiles) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/chacachon?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/chacachon?sslmode=require"

# --- NextAuth / Google OAuth (required for family profile editing) ---
NEXTAUTH_URL="http://localhost:3000"
# Production: https://chacachon-stories.vercel.app
NEXTAUTH_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Admin (optional) ---
# Comma-separated emails with admin access (publish stories, /admin in future)
ADMIN_EMAILS="tu-email@gmail.com"
